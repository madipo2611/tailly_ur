SIGNING_URL_BASE=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
DATABASE_URL=postgres://digital_notary:development-only@localhost:5432/digital_notary?sslmode=disable
# Sber ID OIDC. Register https://tailly.ru/v1/auth/sber/callback in the Sber ID partner cabinet.
# Keep all values in a Kubernetes Secret, never in this file or Git.
# SBER_ID_CLIENT_ID=from-sber-partner-cabinet
# SBER_ID_CLIENT_SECRET=from-sber-partner-cabinet
# SBER_ID_REDIRECT_URI=https://tailly.ru/v1/auth/sber/callback
# SBER_ID_AUTH_URL=from-sber-oidc-configuration
# SBER_ID_TOKEN_URL=from-sber-oidc-configuration
# SBER_ID_ISSUER=from-sber-oidc-configuration
# SBER_ID_JWKS_URL=from-sber-oidc-configuration
# OIDC_STATE_HMAC_KEY=base64-encoded-random-32-byte-key
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=digital-notary.documents
RABBITMQ_URL=amqp://digital_notary:development-only@localhost:5672/
# Use these only after configuring an isolated object-storage gateway.
# OBJECT_STORAGE_URL=https://objects.internal.example
# OBJECT_STORAGE_TOKEN=injected-by-kubernetes-secret
