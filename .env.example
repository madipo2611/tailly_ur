# S3_SECRET_ACCESS_KEY=injected-by-kubernetes-secret
# SMS_GATEWAY_URL=https://sms-gateway.internal.example/v1/messages
# SMS_GATEWAY_TOKEN=injected-by-kubernetes-secret
# BILLING_WEBHOOK_SECRET=injected-by-kubernetes-secret
